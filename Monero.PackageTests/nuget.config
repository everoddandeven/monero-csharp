<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!-- only the package that was built (and the native package it needs), so nothing from nuget.org can stand in for it -->
        <clear />
        <add key="local" value="packages" />
        <!-- Monero.Native, which Monero.NET depends on, until it is on nuget.org -->
        <add key="native" value="../native-packages" />
    </packageSources>
</configuration>

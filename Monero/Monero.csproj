<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\Version.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <!-- the NuGet package. Its version is in Version.props, and the CI checks that a tag v<version> matches it -->
        <PackageId>Monero.NET</PackageId>
        <Version>$(MoneroNetVersion)</Version>
        <Authors>Libmonero</Authors>
        <Description>C# library for using Monero.</Description>
        <PackageTags>monero;xmr;cryptocurrency;wallet;daemon</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/libmonero/monero-csharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/libmonero/monero-csharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- the same bytes from the same source, wherever the package is built -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Daemon\Model\" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Monero.UnitTests" />
    </ItemGroup>

    <!--
      The C library of monero-c, loaded as "monero_c". The project builds it from the submodule before Monero, and copies it to the output of
      Monero and of the projects that reference it, so that the tests find it. CI builds it in native.yml and puts it in the build folder of the
      submodule. The package is the dependency of Monero.NET, and package.yml and Monero.PackageTests use it: -p:MoneroNativeFromPackage=true
    -->
    <PropertyGroup>
        <MoneroCBuild>$(MSBuildThisFileDirectory)..\external\monero-c\build\</MoneroCBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(MoneroNativeFromPackage)' == 'true'">
        <PackageReference Include="Monero.Native" Version="$(MoneroNativeVersion)" />
    </ItemGroup>

    <ItemGroup Condition="'$(MoneroNativeFromPackage)' != 'true'">
        <ProjectReference Include="..\external\monero-c\native\Monero.Native.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!-- the files are looked for when the references are built, since the library may not exist before -->
    <Target Name="IncludeMoneroNative" AfterTargets="ResolveProjectReferences" BeforeTargets="AssignTargetPaths" Condition="'$(MoneroNativeFromPackage)' != 'true'">
        <ItemGroup>
            <None Include="$(MoneroCBuild)libmonero_c.so" Condition="Exists('$(MoneroCBuild)libmonero_c.so')" Link="libmonero_c.so" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(MoneroCBuild)libmonero_c.dylib" Condition="Exists('$(MoneroCBuild)libmonero_c.dylib')" Link="libmonero_c.dylib" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(MoneroCBuild)libmonero_c.dll" Condition="Exists('$(MoneroCBuild)libmonero_c.dll')" Link="monero_c.dll" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(MoneroCBuild)libusb-1.0.so.0" Condition="Exists('$(MoneroCBuild)libusb-1.0.so.0')" Link="libusb-1.0.so.0" CopyToOutputDirectory="PreserveNewest" />
            <None Include="$(MoneroCBuild)libusb-1.0.dll" Condition="Exists('$(MoneroCBuild)libusb-1.0.dll')" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>

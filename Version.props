<Project>

    <!-- the version of the package Monero.NET, read by the library, by the program that uses the package, and by the CI -->
    <PropertyGroup>
        <MoneroNetVersion>0.1.0-alpha.1</MoneroNetVersion>
        <!-- the native runtime package of monero-c that the library loads, Monero.Native -->
        <MoneroNativeVersion>0.2.0-alpha.1</MoneroNativeVersion>
    </PropertyGroup>

</Project>

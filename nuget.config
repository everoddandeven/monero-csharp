<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Monero.Native, until it is on nuget.org. Pack it from monero-c (see README) -->
        <add key="native" value="native-packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="native">
            <package pattern="Monero.Native" />
        </packageSource>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
